int[] squares(int count) {
    int[] result = new_int_array(count);
    int i = 0;
    while (i < count) {
        result[i] = i * i;
        i += 1;
    }
    return result;
}
int sum(int[] values) {
    int result = 0;
    int i = 0;
    while (i < len(values)) {
        result += values[i];
        i += 1;
    }
    return result;
}
int main() {
    int[] a = squares(6);
    int[] alias = a;
    alias[2] += 10;
    print_int(sum(a));
    write('\n');
    return 0;
}
