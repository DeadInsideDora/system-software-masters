int factorial(int n) {
    if (n <= 1) return 1;
    return n * factorial(n - 1);
}
int even(int n) {
    if (n == 0) return 1;
    return odd(n - 1);
}
int odd(int n) {
    if (n == 0) return 0;
    return even(n - 1);
}
void show(string label, int value) {
    write(label);
    print_int(value);
    write('\n');
}
int main() {
    show("factorial(6) = ", factorial(6));
    show("even(12) = ", even(12));
    int original = 7;
    int copy = original;
    show("copy = ", copy);
    return 0;
}
