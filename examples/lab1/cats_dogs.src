
int[] filter_indices(string[] sounds, string target) {
    int count = 0;
    int i = 0;
    while (i < len(sounds)) {
        if (sounds[i] == target) {
            count += 1;
        }
        i += 1;
    }

    int[] result = new_int_array(count);
    int position = 0;
    i = 0;
    while (i < len(sounds)) {
        if (sounds[i] == target) {
            result[position] = i;
            position += 1;
        }
        i += 1;
    }
    return result;
}

string[] map_names(string[] names, int[] indices) {
    string[] result = new_string_array(len(indices));
    int i = 0;
    while (i < len(indices)) {
        result[i] = names[indices[i]];
        i += 1;
    }
    return result;
}

void print_names(string[] names) {
    int i = 0;
    while (i < len(names)) {
        write(names[i] + "\n");
        i += 1;
    }
}

int main() {
    string[] names = new_string_array(7);
    string[] sounds = new_string_array(7);
    names[0] = "Dog A"; sounds[0] = "barks";
    names[1] = "Dog B"; sounds[1] = "barks";
    names[2] = "Cat C"; sounds[2] = "meow";
    names[3] = "Cat D"; sounds[3] = "meow";
    names[4] = "Dog E"; sounds[4] = "barks";
    names[5] = "Dog F"; sounds[5] = "barks";
    names[6] = "Cat G"; sounds[6] = "meow";

    write("== Cats (meow) ==\n");
    print_names(map_names(names, filter_indices(sounds, "meow")));
    write("== Dogs (barks) ==\n");
    print_names(map_names(names, filter_indices(sounds, "barks")));
    return 0;
}
