string greet(string name) {
    return "Hello, " + name + "!\n";
}
string[] names() {
    string[] result = new_string_array(3);
    result[0] = "Alice";
    result[1] = "Боб";
    result[2] = "Cat";
    return result;
}
void print_names(string[] items) {
    int i = 0;
    while (i < len(items)) {
        write(greet(items[i]));
        i += 1;
    }
    return;
}
int main() {
    string[] people = names();
    print_names(people);
    string a = "equal";
    string b = "eq" + "ual";
    print_int(a == b);
    write('\n');
    print_int(len("Привет"));
    write('\n');
    return 0;
}
