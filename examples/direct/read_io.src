void write(char c);
read_int();
read_str(buf);

print_buf(int[] buf, size) {
    i = 0;
    while (i < size) {
        write(buf[i]);
        i += 1;
    }
    return 0;
}

main() {
    int[] buf;

    n = read_int();
    len = read_str(buf);

    print_int(n);
    write(10);
    print_buf(buf, len);
    write(10);
    return 0;
}
