int sum(int[] a, int n) {
    int i = 0, s = 0;
    while (i < n) {
        s = s + a[i];
        i = i + 1;
    }
    return s;
}

void print() {
    printf("Hello, world!");
}

int main() {
    int[] arr;
    int x = 5, y;
    if (x == 5) y = x + 1; else y = x - 1;
    do { x = x - 1; } while (x > 0);
    sum(x, 2);
    return 0;
}
