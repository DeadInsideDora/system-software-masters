void write(char c);

put_int(a) {
    if (a > 9) {
        put_int(a / 10);
    }
    if (a != 0) write((a % 10) + '0');
}

fact(n) {
    if (n < 0) {
        return 0;
    } else if (n == 1) {
        return 1;
    }
    return n * fact(n - 1);
}

main() {
    a = "Hello, world!";
    i = 0;
    while (i < 13) {
        write(a[i]);
        i += 1;
    }
    write(10);

    a = 3;
    put_int(a);
    write(10);

    a = a + fact(5);
    put_int(a);
    write(10);

    return 0;
}
