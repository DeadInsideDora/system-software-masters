void write(char c);
char read();
read_int();
read_str(buf);

put_str(int[] buf, size) {
    i = 0;
    while (i < size) {
        write(buf[i]);
        i += 1;
    }
}

put_int(a) {
    if (a == 0) {
        write('0');
        return 0;
    }
    if (a < 0) {
        write('-');
        a = 0 - a;
    }
    if (a > 9) {
        put_int(a / 10);
    }
    write((a % 10) + '0');
}

main() {
    int[] buf;

    n = read_int();
    len = read_str(buf);

    put_int(n);
    write(10);
    put_str(buf, len);
    write(10);

    return 0;
}
