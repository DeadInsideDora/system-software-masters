int[] stats(int[] values) {
    int[] result = new_int_array(4);
    result[0] = len(values);
    if (len(values) == 0) return result;
    result[2] = values[0];
    result[3] = values[0];
    int i = 0;
    while (i < len(values)) {
        result[1] += values[i];
        if (values[i] < result[2]) result[2] = values[i];
        if (values[i] > result[3]) result[3] = values[i];
        i += 1;
    }
    return result;
}

int[] scale(int[] values, int factor) {
    int multiply(int x) { return x * factor; }
    int i = 0;
    while (i < len(values)) {
        values[i] = multiply(values[i]);
        i += 1;
    }
    return values;
}

string[] greet(string[] names) {
    string[] messages = new_string_array(len(names));
    int i = 0;
    while (i < len(names)) {
        messages[i] = "Привет, " + names[i] + "!";
        i += 1;
    }
    return messages;
}
