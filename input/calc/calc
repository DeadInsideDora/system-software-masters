void write(char c);
char read();

put_str(str, size) {
    i = 0;
    while (i < size) {
        write(str[i]);
        i +=1;
    }
}

put_int(a) {
    if (a == 0) {
        write('0');
    } else {
        if (a > 9) put_int(a / 10);
        write((a % 10) + '0');
    }
}

get_int() {
    a = 0;
    c = read();

    while (c == 10 | c == 13 | c == ' ') {
        c = read();
    }
    while (c >= '0' & c <= '9') {
        a = 10*a + (c - '0');
        c = read();
    }
    a;
}

get_value() {
    c = read();
    while (c == 10 | c == 13 | c == ' ') {
        c = read();
    }
    if (c == 'f') {
        n = get_int();
        fib(n);
    } else if (c == '!') {
        n = get_int();
        fact(n);
    } else {
        a = 0;
        while (c >= '0' & c <= '9') {
            a = 10*a + (c - '0');
            c = read();
        }
        a;
    }
}

fib(n) {
    result = 0;
    if (n <= 0) {
        result = 0;
    } else if (n == 1) {
        result = 1;
    } else {
        a = 0;
        b = 1;
        i = 2;
        while (i <= n) {
            c = a + b;
            a = b;
            b = c;
            i += 1;
        }
        result = b;
    }
    result;
}

fact(n) {
    result = 1;
    if (n < 0) {
        result = 0;
    } else {
        i = 2;
        while (i <= n) {
            result = result * i;
            i += 1;
        }
    }
    result;
}

calc() {
    put_str(">: ", 3);
    a = get_value();

    while(true) {
        put_str(">: ", 3);
        op = read();
        while (op == 10 | op == 13 | op == ' ') {
            op = read();
        }
        
        if (op == 'q') break;
        put_str(">: ", 3);
        b = get_value();

        put_str("= ", 2);
         
        if (op == '+') {
            a = a + b;
        } else if (op == '-') {
            a = a - b;
        } else if (op == '*') {
            a = a * b;
        } else if (op == '/') {
            a = a / b;
        } else if (op == '%') {
            a = a % b;
        }
        put_int(a);
        write(10);
    }
}
