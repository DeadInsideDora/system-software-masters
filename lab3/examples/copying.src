int main() {
    int heap = 1;
    int space = vm_arg(0);
    int roots = vm_arg(1);
    int rounds = vm_arg(2);
    vm_assert(roots >= 5, 100);
    vm_assert(space >= 4 * GC_HEADER_WORDS + 7, 101);
    gc_init(heap, space, roots);
    int a = gc_root(heap);
    int b = gc_root(heap);
    int dead_a = gc_root(heap);
    int dead_b = gc_root(heap);
    int temporary = gc_root(heap);
    vm_assert(gc_new(heap, a, 3, 2), 102);
    vm_assert(gc_new(heap, b, 2, 1), 102);
    vm_assert(gc_new(heap, dead_a, 1, 1), 102);
    vm_assert(gc_new(heap, dead_b, 1, 1), 102);
    gc_set_ref(heap, a, 0, b);
    gc_set_ref(heap, a, 1, b);
    gc_set_ref(heap, b, 0, a);
    gc_set_value(heap, a, 2, 123);
    gc_set_value(heap, b, 1, 456);
    gc_set_ref(heap, dead_a, 0, dead_b);
    gc_set_ref(heap, dead_b, 0, dead_a);
    gc_clear(heap, b);
    gc_clear(heap, dead_a);
    gc_clear(heap, dead_b);
    int before = gc_address(heap, a);
    vm_print(gc_used(heap));
    vm_print(before);
    gc_collect(heap);
    vm_print(gc_address(heap, a));
    vm_print(gc_used(heap));
    vm_assert(gc_address(heap, a) != before && gc_verify(heap) == 2, 103);
    int i = 0;
    while (i < rounds) {
        gc_clear(heap, temporary);
        vm_assert(gc_new(heap, temporary, 1, 0), 104);
        gc_set_value(heap, temporary, 0, i);
        vm_assert(gc_value(heap, a, 2) == 123, 105);
        i += 1;
    }
    gc_clear(heap, temporary);
    gc_collect(heap);
    gc_get_ref(heap, b, a, 0);
    gc_get_ref(heap, dead_a, a, 1);
    vm_assert(gc_address(heap, b) == gc_address(heap, dead_a), 106);
    gc_get_ref(heap, dead_b, b, 0);
    vm_assert(gc_address(heap, a) == gc_address(heap, dead_b), 107);
    vm_assert(gc_verify(heap) == 2, 108);
    vm_print(gc_value(heap, a, 2) + gc_value(heap, b, 1));
    vm_print(gc_used(heap));
    vm_print(vm_load(heap + GC_COLLECTIONS));
    vm_print(vm_load(heap + GC_ALLOCATED_OBJECTS));
    vm_print(vm_load(heap + GC_ALLOCATED_WORDS));
    vm_print(vm_load(heap + GC_COPIED_OBJECTS));
    vm_print(vm_load(heap + GC_COPIED_WORDS));
    vm_print(vm_load(heap + GC_RECLAIMED_WORDS));
    vm_print(vm_load(heap + GC_PEAK_WORDS));
    vm_print(vm_load(heap + GC_ROOT_VISITS));
    vm_print(vm_load(heap + GC_EDGE_VISITS));
    gc_release(heap, 0);
    gc_collect(heap);
    vm_assert(gc_used(heap) == 0 && gc_verify(heap) == 0, 109);
    vm_assert(vm_load(heap + GC_RECLAIMED_WORDS) == vm_load(heap + GC_ALLOCATED_WORDS), 110);
    vm_print(vm_load(heap + GC_COLLECTIONS));
    vm_print(gc_used(heap));
    vm_print(vm_load(heap + GC_RECLAIMED_WORDS));
    return 0;
}
