void bb_number(int value) {
    vm_out(44);
    print_int(value);
}

void bb_state(int heap, int step, int phase) {
    print("STATE");
    bb_number(step);
    bb_number(phase);
    bb_number(gc_used(heap));
    bb_number(vm_load(heap + GC_ALLOCATED_OBJECTS));
    bb_number(vm_load(heap + GC_COLLECTIONS));
    bb_number(vm_load(heap + GC_RECLAIMED_WORDS));
    vm_out(10);
    vm_assert(gc_verify(heap) * 6 == gc_used(heap), 300);
}

void bb_snapshot(int heap, int[] pool, int count, int capacity, int step, int phase) {
    print("SNAP"); bb_number(step); bb_number(phase); vm_out(10);
    int mark = gc_mark(heap);
    int scratch = gc_root(heap);
    int[] seen = new_int_array(capacity);
    int[] queue = new_int_array(capacity);
    int length = 0;
    int i = 0;
    while (i < count) {
        int id = gc_value(heap, pool[i], 2);
        vm_assert(id > 0 && id < capacity, 301);
        if (!seen[id]) {
            seen[id] = 1;
            queue[length] = gc_root(heap);
            gc_assign(heap, queue[length], pool[i]);
            length += 1;
        }
        i += 1;
    }
    int head = 0;
    while (head < length) {
        int root = queue[head];
        print("NODE"); bb_number(gc_value(heap, root, 2));
        int field = 0;
        while (field < 2) {
            gc_get_ref(heap, scratch, root, field);
            int reference_id = 0;
            if (gc_address(heap, scratch) != 0) {
                reference_id = gc_value(heap, scratch, 2);
                vm_assert(reference_id > 0 && reference_id < capacity, 302);
                if (!seen[reference_id]) {
                    seen[reference_id] = 1;
                    queue[length] = gc_root(heap);
                    gc_assign(heap, queue[length], scratch);
                    length += 1;
                }
            }
            bb_number(reference_id);
            field += 1;
        }
        vm_out(10);
        head += 1;
    }
    gc_release(heap, mark);
    print("END"); bb_number(length); vm_out(10);
}

int main() {
    int heap = 1;
    int space = vm_arg(0);
    int steps = vm_arg(1);
    int random = vm_arg(2);
    int interval = vm_arg(3);
    vm_assert(steps >= 0 && steps <= 10000 && space >= 6, 303);
    vm_assert(random > 0 && random < 2147483647 && interval > 0, 304);
    int capacity = steps + 1;
    int pool_capacity = space / 6 + 1;
    gc_init(heap, space, pool_capacity * 2 + 1);
    int[] pool = new_int_array(pool_capacity);
    int i = 0;
    while (i < pool_capacity) {
        pool[i] = gc_root(heap);
        i += 1;
    }
    int count = 0;
    bb_state(heap, 0, 0);
    bb_snapshot(heap, pool, count, capacity, 0, 0);
    int step = 1;
    while (step <= steps) {
        random = (random * 48271) % 2147483647;
        int choice = random % 100;
        random = (random * 48271) % 2147483647;
        int first = random;
        random = (random * 48271) % 2147483647;
        int second = random;
        random = (random * 48271) % 2147483647;
        int field = random % 2;
        int kind = 0;
        int source = 0;
        int target = 0;
        int success = 0;
        if (choice < 35) {
            kind = 1;
            source = step;
            success = gc_new(heap, pool[count], 3, 2);
            if (success) {
                gc_set_value(heap, pool[count], 2, source);
                count += 1;
            }
        } else if (choice < 65) {
            kind = 2;
            if (count > 0) {
                int index = first % count;
                int destination = second % (count + 1);
                source = gc_value(heap, pool[index], 2);
                int target_root = 0;
                if (destination < count) {
                    target_root = pool[destination];
                    target = gc_value(heap, target_root, 2);
                }
                gc_set_ref(heap, pool[index], field, target_root);
                success = 1;
            }
        } else {
            kind = 3;
            if (count > 0) {
                int removed_index = first % count;
                source = gc_value(heap, pool[removed_index], 2);
                gc_clear(heap, pool[removed_index]);
                count -= 1;
                if (removed_index != count) {
                    gc_assign(heap, pool[removed_index], pool[count]);
                    gc_clear(heap, pool[count]);
                }
                success = 1;
            }
        }
        print("OP"); bb_number(step); bb_number(kind); bb_number(source);
        bb_number(target); bb_number(field); bb_number(success); vm_out(10);
        bb_state(heap, step, kind);
        if (step % interval == 0) {
            bb_snapshot(heap, pool, count, capacity, step, kind);
        }
        step += 1;
    }
    bb_snapshot(heap, pool, count, capacity, steps, 7);
    i = 0;
    while (i < count) {
        gc_clear(heap, pool[i]);
        i += 1;
    }
    count = 0;
    bb_state(heap, steps, 5);
    bb_snapshot(heap, pool, count, capacity, steps, 5);
    vm_assert(vm_load(heap + GC_ALLOCATED_WORDS) == vm_load(heap + GC_RECLAIMED_WORDS) + gc_used(heap), 306);
    vm_trace(heap, GC_TRACE_END);
    print("BLACKBOX GC: OK\n");
    return 0;
}
